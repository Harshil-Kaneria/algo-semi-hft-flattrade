# ──────────────────────────────────────────────────────────────────────────────
# FLATTRADE CREDENTIALS  —  copy this file to .env and fill in your values
#
#   cp .env.example .env      (Linux/Mac)
#   copy .env.example .env    (Windows)
#
# .env is listed in .gitignore and will NEVER be committed to version control.
# .env.example IS committed — it documents the required variables without real
# values, so teammates know what to set.
# ──────────────────────────────────────────────────────────────────────────────

# Your Flattrade login / User ID  (e.g. FT12345)
FLATTRADE_USER_ID=

# Daily session token — regenerate each morning using:  python get_token.py
# Expires every 24 hours (or at midnight IST).
FLATTRADE_API_TOKEN=

# Optional — only needed if Flattrade requires API key / secret for token exchange
# (Some broker configurations use this for the code→token exchange step)
FLATTRADE_API_KEY=
FLATTRADE_API_SECRET=
