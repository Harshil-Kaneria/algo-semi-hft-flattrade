# ──────────────────────────────────────────────────────────────────────────────
# FLATTRADE CREDENTIALS  —  copy this file to .env and fill in your values
#
#   copy .env.example .env    (Windows)
#   cp   .env.example .env    (Linux/Mac)
#
# .env is listed in .gitignore and will NEVER be committed to version control.
# .env.example IS committed — it documents required variables without real values.
# ──────────────────────────────────────────────────────────────────────────────


# ── Your Flattrade broker login ID  (e.g. FT12345) ───────────────────────────
FLATTRADE_USER_ID=


# ── Pi API App Key ────────────────────────────────────────────────────────────
# This is the app_key (client_id) created from the Flattrade Pi portal:
#   1. Go to https://wall.flattrade.in/login
#   2. Click the Pi Menu → Create New API Key
#   3. Fill App Name, Short Name, Redirect URL (e.g. http://localhost:8080), Description
#   4. Copy the generated API Key here.
#
# This key is used to build the daily login URL:
#   https://auth.flattrade.in/?app_key=<FLATTRADE_API_KEY>
FLATTRADE_API_KEY=


# ── Daily Session Token ───────────────────────────────────────────────────────
# Generated each morning by running:  python get_token.py
#
# How it works (Flattrade login flow):
#   1. Open https://auth.flattrade.in/?app_key=<FLATTRADE_API_KEY> in browser
#   2. Log in with User ID + Password + OTP
#   3. Browser redirects to your Redirect URL with ?code=XXXXXX
#   4. That code IS the session token (susertoken) — paste it here, OR
#      run python get_token.py which does this automatically.
#
# Expires: daily (at midnight IST). Must be refreshed every trading day.
FLATTRADE_API_TOKEN=
