# ──────────────────────────────────────────────────────────────────────────────
# FLATTRADE CREDENTIALS  —  copy this file to .env and fill in your values
#
#   copy .env.example .env    (Windows)
#   cp   .env.example .env    (Linux/Mac)
#
# .env is listed in .gitignore and will NEVER be committed to version control.
# .env.example IS committed — it documents required variables without real values.
# ──────────────────────────────────────────────────────────────────────────────


# ── Your Flattrade broker login ID  (e.g. FZ21639) ───────────────────────────
FLATTRADE_USER_ID=


# ── Pi API App Key ────────────────────────────────────────────────────────────
# Created from the Flattrade Pi portal:
#   1. Go to https://wall.flattrade.in/login
#   2. Click Pi Menu → Create New API Key
#   3. Copy the generated API Key here.
FLATTRADE_API_KEY=


# ── Pi API App Secret ─────────────────────────────────────────────────────────
# Created alongside the API Key from the Flattrade Pi portal (wall.flattrade.in).
# Used by get_token.py to compute SHA-256 hash for daily token exchange.
FLATTRADE_API_SECRET=


# ── Daily Session Token (susertoken) ──────────────────────────────────────────
# Generated each morning by running:  python get_token.py
#
# How it works (Flattrade official auth flow):
#   1. Open https://auth.flattrade.in/?app_key=<FLATTRADE_API_KEY> in browser
#   2. Log in with User ID + Password + OTP / 2FA
#   3. Browser redirects to your Redirect URL with ?code=REQUEST_CODE
#   4. Run `python get_token.py` and paste the redirected URL
#   5. get_token.py exchanges request_code + SHA-256 hash for the real session token
#      and saves it into FLATTRADE_API_TOKEN below.
#
# Expires: daily (at midnight IST). Must be refreshed every trading day.
FLATTRADE_API_TOKEN=
